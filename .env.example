COUCHBASE_ENDPOINT=
COUCHBASE_USER=
COUCHBASE_PASSWORD=
COUCHBASE_BUCKET=voyageops
# Eventing deploy (setup-eventing.ts REST mode); admin credentials often required
# Hostname only — do NOT include https:// (leave empty to use COUCHBASE_ENDPOINT host)
COUCHBASE_EVENTING_HOST=
COUCHBASE_EVENTING_PORT=8096
# Set true to force https for Eventing REST; otherwise https when COUCHBASE_ENDPOINT uses couchbases://
COUCHBASE_EVENTING_USE_TLS=
# Search index deploy (setup-vector-indexes.ts / setup-search-indexes.ts REST); admin often required
COUCHBASE_SEARCH_HOST=
COUCHBASE_SEARCH_PORT=8094
COUCHBASE_SEARCH_USE_TLS=
# Self-managed cluster only (setup-eventing.ts --driver=cli)
COUCHBASE_CLI_CLUSTER=
COUCHBASE_CLI_USERNAME=
COUCHBASE_CLI_PASSWORD=
# OpenAI — no spaces around =, no quotes around values (e.g. OPENAI_API_KEY=sk-...)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Vector index names (must match database/create.vector.indexes.sql after npm run demo:setup-vector-indexes)
CB_VECTOR_INDEX_CATEGORY=voGuestIncident_vector_category_incidents
CB_VECTOR_INDEX_TYPE=voGuestIncident_vector_type_incidents
CB_VECTOR_INDEX_DESC=voGuestIncident_vector_desc_incidents
# Playbook Search (FTS) index — short name for self-managed REST deploy; GSI vector index uses same short name.
# Capella UI often registers scoped FTS names (worker auto-resolves): voyageops.agent.voAgent_vector_playbooks_embedding
CB_PLAYBOOK_VECTOR_INDEX=voAgent_vector_playbooks_embedding
# voyageops.agent.outcomes(embedding) — index may stay building until outcomes docs exist
CB_VECTOR_INDEX_OUTCOMES=voAgent_vector_outcomes_embedding
GUEST_RECOVERY_CHAT_VERBOSITY=normal
# Guest Recovery worker — load prompts from Couchbase Agent Catalog (agentc) when true
GUEST_RECOVERY_USE_AGENTC=false

# Couchbase Agent Catalog (agentc) — https://docs.couchbase.com/ai/build/integrate-agent-with-catalog.html
# Reuses cluster credentials; agentc publish creates voyageops.agent_catalog scope
AGENT_CATALOG_CONN_STRING=
AGENT_CATALOG_USERNAME=
AGENT_CATALOG_PASSWORD=
AGENT_CATALOG_BUCKET=voyageops
AGENT_CATALOG_CATALOG=.agent-catalog
AGENT_CATALOG_ACTIVITY=.agent-activity
# Required for couchbases:// (TLS). Absolute path to a CA cert file — leave unset to fall back to the
# certifi bundle (Capella certs are publicly signed, so this works without downloading anything);
# set explicitly only if you need a specific cert (e.g. a self-managed cluster with a private CA).
# AGENT_CATALOG_CONN_ROOT_CERTIFICATE=/absolute/path/to/cert.pem
# AGENT_CATALOG_EMBEDDING_MODEL=all-MiniLM-L12-v2
